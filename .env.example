# Meta / Facebook App credentials (from developers.facebook.com)
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret

# Optional: long-lived User Access Token (if not using OAuth flow)
# FACEBOOK_USER_ACCESS_TOKEN=your_long_lived_user_token

# Server
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# Optional: protect the endpoint with a bearer token
# MCP_SECRET=your_secret_token
